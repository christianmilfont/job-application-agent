# Copie para .env e ajuste. O arquivo .env NUNCA deve ser versionado.

# Modo de operação: DRY_RUN (padrão) | DISCOVERY | ASSISTED
JOBAGENT_MODE=DRY_RUN

# Banco de dados. Padrão: SQLite em data/jobagent.db
# Para PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/jobagent
# JOBAGENT_DATABASE_URL=

JOBAGENT_LOG_LEVEL=INFO

# Rate limiting conservador (por host)
JOBAGENT_HTTP_MIN_INTERVAL_S=3.0
JOBAGENT_HTTP_JITTER_S=1.5
JOBAGENT_HTTP_MAX_REQUESTS_PER_RUN=100
JOBAGENT_HTTP_MAX_RETRIES=3
JOBAGENT_RESPECT_ROBOTS_TXT=true

# --- LLM (geração de currículo e análise ATS) -------------------------------
# Chave da API Anthropic (console.anthropic.com). Sem chave, o currículo é gerado
# em modo determinístico (sem LLM), só reorganizando o profile.yaml.
ANTHROPIC_API_KEY=
JOBAGENT_LLM_PROVIDER=anthropic
JOBAGENT_LLM_MODEL=claude-sonnet-5-5
# Esforço de raciocínio: low | medium | high | xhigh | max
JOBAGENT_LLM_EFFORT=high
JOBAGENT_LLM_MAX_TOKENS=16000
# Fallback server-side se o modelo recusar a requisição (Claude API)
JOBAGENT_LLM_FALLBACKS=true
# 1 geração + 1 correção guiada pelo validador
JOBAGENT_LLM_MAX_ATTEMPTS=2

# Não há variáveis de login do LinkedIn de propósito: o sistema não automatiza
# login nem coleta no LinkedIn (proibido pelos termos da plataforma).
# Vagas do LinkedIn entram via importação manual (jobagent import).
